<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="7dp" android:padding="14dp"
    android:background="@drawable/card_background" android:orientation="vertical">
    <TextView android:id="@+id/tvRecordingTime" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Événement"
        android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_main"/>
    <TextView android:id="@+id/tvRecordingDetail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Durée"
        android:paddingTop="3dp" android:textColor="@color/text_muted"/>
</LinearLayout>
